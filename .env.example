IMAP_HOST=mail.appelo.nl
IMAP_PORT=993
# Dovecot on mail.appelo.nl expects the local part, not the full address
IMAP_USER=dmarc
IMAP_PASSWORD=
IMAP_REPORTS_FOLDER=INBOX
IMAP_ARCHIVE_FOLDER=Processed
# 0 = no limit per run; parsedmarc's own default is 10
IMAP_BATCH_SIZE=0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dmarc
DB_USER=dmarc
DB_PASSWORD=

DMARC_OFFLINE=true

# The domains this dashboard is about (comma-separated); reports about other
# domains are skipped. The first is our own: public, and the only one with TLS
# reports and the security page. The others need a password (DOMAIN_PASSWORDS)
# and only get the DMARC report pages, at /dmarc/<domain>/.
MONITORED_DOMAINS=appelo.nl

# One "<domain>=<hash>" per extra domain, comma-separated; make an entry with
# venv/bin/python scripts/hash_domain_password.py <domain>
DOMAIN_PASSWORDS=
# Signs the login cookie; needed once DOMAIN_PASSWORDS is set. Generate with
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The login cookie is HTTPS-only; set to false to log in over plain http (dev)
SESSION_COOKIE_SECURE=true

# Used by app.py to read mailsec.* (populated by scripts/fetch_mail_security_events.py,
# which runs on the mail server itself, 192.168.93.10)
MAILSEC_DB_HOST=localhost
MAILSEC_DB_PORT=5432
MAILSEC_DB_NAME=dmarc
MAILSEC_DB_USER=mailsec
MAILSEC_DB_PASSWORD=

# Who may see the security page (comma-separated networks); default is the home LAN + public IPs
SECURITY_ALLOWED_NETWORKS=192.168.93.0/24,45.142.232.176/32,2a10:3781:5551:1::/64

# Fixed "Gebruiker X" letters on the security page; other own addresses get the next free letter.
FIXED_PSEUDONYMS=alice@example.org=A,bob@example.org=B
