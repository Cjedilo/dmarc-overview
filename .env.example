IMAP_HOST=mail.appelo.nl
IMAP_PORT=993
# Dovecot op mail.appelo.nl verwacht het lokale deel, niet het volledige adres
IMAP_USER=dmarc
IMAP_PASSWORD=
IMAP_REPORTS_FOLDER=INBOX
IMAP_ARCHIVE_FOLDER=Processed
# 0 = geen limiet per run; parsedmarc's eigen default is 10
IMAP_BATCH_SIZE=0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dmarc
DB_USER=dmarc
DB_PASSWORD=

DMARC_OFFLINE=true
